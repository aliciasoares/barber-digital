<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <title>Barber Shop - Editar Atendimento</title>


    <style>
        :root {
            --bg-page: #f9f5f0;
            --sidebar-brown: #3d1f14;
            --text-creme: #e6d5c3;
            --input-beige: #efe1d1;
            --btn-dark: #220f08;
            --accent-gold: #d4a373;
        }


        body {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
                        url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px 0;
            backdrop-filter: blur(8px);
        }


        .edit-card {
            width: 100%;
            max-width: 950px;
            min-height: 650px;
            background: rgba(253, 246, 236, 0.95);
            display: flex;
            border-radius: 50px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }


        .sidebar-card {
            flex: 1;
            background: var(--sidebar-brown);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-creme);
            padding: 40px;
            text-align: center;
            border-radius: 0 160px 160px 0;
        }


        .barber-icon {
            width: 100px;
            filter: invert(86%) sepia(13%) saturate(542%) hue-rotate(349deg) brightness(95%) contrast(89%);
            margin-bottom: 20px;
        }


        .sidebar-card h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            line-height: 1.1;
            text-transform: uppercase;
            letter-spacing: 2px;
        }


        .form-section {
            flex: 1.4;
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }


        .form-section h2 {
            font-family: 'Playfair Display', serif;
            color: var(--sidebar-brown);
            font-size: 2.3rem;
            margin-bottom: 5px;
            text-align: center;
        }


        .subtitle {
            color: var(--accent-gold);
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 1px;
            margin-bottom: 30px;
            text-transform: uppercase;
            text-align: center;
        }


        .label-text {
            display: block;
            text-align: left;
            margin-left: 20px;
            margin-bottom: 5px;
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--sidebar-brown);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }


        .custom-input, .custom-select {
            background-color: var(--input-beige) !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 10px 22px !important;
            color: var(--sidebar-brown) !important;
            font-size: 0.9rem;
            width: 100%;
        }
       
        .custom-input:focus, .custom-select:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(61, 31, 20, 0.1) !important;
        }


        .btn-update {
            background-color: var(--btn-dark) !important;
            color: white !important;
            border-radius: 50px !important;
            padding: 14px !important;
            font-weight: 700;
            width: 100%;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
        }


        .btn-update:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }


        .actions-wrapper {
            text-align: center;
            width: 100%;
        }


        .back-link {
            display: inline-block;
            margin-top: 25px;
            font-size: 0.85rem;
            color: #777;
            text-decoration: none;
            transition: 0.3s;
        }


        .back-link:hover {
            color: var(--sidebar-brown);
        }
    </style>
</head>
<body>


    <div class="edit-card">
        <div class="sidebar-card">
            <img src="https://cdn-icons-png.flaticon.com/512/81/81139.png" class="barber-icon" alt="ícone tesoura">
            <h1>BARBERSHOP</h1>
            <p style="margin-top: 15px; opacity: 0.8; font-size: 0.9rem;">Atualize os agendamentos da agenda com precisão.</p>
        </div>


        <div class="form-section">
            <div class="w-100">
                <h2>Editar Atendimento</h2>
                <p class="subtitle">Alterando registro de <b><%= atendimento.nomeCliente %></b></p>


                <form id="formEdicao">
                    <input value="<%= atendimento.id %>" type="hidden" id="atendimentoId">


                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <span class="label-text">Nome do Cliente</span>
                            <input value="<%= atendimento.nomeCliente %>" type="text" id="nomeCliente" class="form-control custom-input" required>
                        </div>
                        <div class="col-md-6">
                            <span class="label-text">Telefone / WhatsApp</span>
                            <input value="<%= atendimento.telefone %>" type="tel" id="telefone" class="form-control custom-input" required>
                        </div>
                    </div>


                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <span class="label-text">Data do Atendimento</span>
                            <input value="<%= atendimento.dataAtendimento %>" type="date" id="dataAtendimento" class="form-control custom-input" required>
                        </div>
                        <div class="col-md-6">
                            <span class="label-text">Horário</span>
                            <input value="<%= atendimento.horarioAtendimento %>" type="time" id="horarioAtendimento" class="form-control custom-input" required>
                        </div>
                    </div>


                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <span class="label-text">Data de Nascimento</span>
                            <input value="<%= atendimento.dataNascimento %>" type="date" id="dataNascimento" class="form-control custom-input">
                        </div>
                        <div class="col-md-6">
                            <span class="label-text">Tipo de Serviço</span>
                            <input value="<%= atendimento.tipoServico %>" type="text" id="tipoServico" class="form-control custom-input" placeholder="Ex: Cabelo, Barba, Combo..." required>
                        </div>
                    </div>


                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <span class="label-text">Profissional Responsável</span>
                            <select class="form-select custom-select" id="profissional" required>
                                <% for(const usuario of usuarios) { %>
                                    <option value="<%= usuario.id %>"
                                        <%= String(atendimento.profissional) === String(usuario.id) ? "selected" : "" %>>
                                        <%= usuario.nome %>
                                    </option>
                                <% } %>
                            </select>
                        </div>
                    </div>


                    <div class="actions-wrapper">
                        <button id="btnSalvar" type="submit" class="btn btn-update">Atualizar Atendimento</button>
                        <a href="/atendimento/list" class="back-link">← Cancelar e voltar para a lista</a>
                    </div>
                </form>
            </div>
        </div>
    </div>


<script>
    const form = document.getElementById("formEdicao");
    const btnSalvar = document.getElementById("btnSalvar");


    form.addEventListener("submit", async (e) => {
        e.preventDefault();


        btnSalvar.disabled = true;
        btnSalvar.innerText = "Atualizando...";


 
        const payload = {
            id: document.getElementById("atendimentoId").value,
            nomeCliente: document.getElementById("nomeCliente").value,
            telefone: document.getElementById("telefone").value,
            dataAtendimento: document.getElementById("dataAtendimento").value,
            horarioAtendimento: document.getElementById("horarioAtendimento").value,
            dataNascimento: document.getElementById("dataNascimento").value,
            tipoServico: document.getElementById("tipoServico").value,
            profissional: document.getElementById("profissional").value
        };


        const url = "/atendimento/edit";


        try {
            const response = await fetch(url, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            });


            if (response.ok) {
                console.log("Atendimento atualizado com sucesso!");
                window.location.href = "/atendimento/list";
            } else {
                console.error("Erro na requisição de edição");
                alert("Não foi possível salvar as alterações do atendimento. Tente novamente.");
               
                btnSalvar.disabled = false;
                btnSalvar.innerText = "Atualizar Atendimento";
            }
        } catch (error) {
            console.error("Erro de conexão:", error);
            alert("Erro de rede. Verifique se o servidor está rodando.");
           
            btnSalvar.disabled = false;
            btnSalvar.innerText = "Atualizar Atendimento";
        }
    });
</script>
</body>
</html>
