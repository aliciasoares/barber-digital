<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --deep-brown: #3d1f14;
            --accent-brown: #a1887f;
            --bg-creme: #f9f5f0;
            --white: #ffffff;
            --soft-brown: rgba(161, 136, 127, 0.15);
        }

        body {
            background-color: var(--bg-creme);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            position: relative;
        }

        .shape {
            position: absolute;
            z-index: -1;
            border-radius: 50%;
            background: var(--soft-brown);
        }
        .shape-1 { width: 450px; height: 450px; top: -150px; left: -100px; }
        .shape-2 { width: 350px; height: 350px; bottom: 10%; right: -50px; }

        .hero-banner {
            height: 400px;
            background: linear-gradient(rgba(61, 31, 20, 0.85), rgba(61, 31, 20, 0.85)), 
                        url('https://images.unsplash.com/photo-1585747860715-2ba37e788b70?q=80&w=2074&auto=format&fit=crop') center/cover no-repeat;
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .hero-banner h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            margin-bottom: 10px;
        }

        .content-wrapper {
            margin-top: -100px;
            padding-bottom: 80px;
            position: relative;
            z-index: 2;
        }

        .list-card {
            background: var(--white);
            border-radius: 40px;
            border: none;
            box-shadow: 0 30px 60px rgba(61, 31, 20, 0.12);
            overflow: hidden;
        }

        .card-header-custom {
            padding: 40px;
            border-bottom: 1px solid #f1ece7;
            background-color: #fff;
        }

        .card-header-custom h2 {
            font-family: 'Playfair Display', serif;
            color: var(--deep-brown);
            font-size: 1.8rem;
            margin: 0;
        }

        .custom-table thead th {
            background-color: #fcfaf8;
            color: var(--accent-brown);
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            padding: 20px 25px;
            border: none;
        }

        .custom-table tbody td {
            padding: 20px 25px;
            vertical-align: middle;
            color: #4a3e3a;
            border-bottom: 1px solid #f8f4f0;
            font-size: 0.95rem;
        }

        .user-id {
            color: var(--accent-brown);
            font-weight: 700;
        }

        .btn-brown-sm {
            background-color: var(--deep-brown);
            color: var(--white);
            border: none;
            padding: 10px 25px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: 0.3s;
        }

        .btn-brown-sm:hover {
            background-color: var(--accent-brown);
            color: white;
            transform: translateY(-2px);
        }

        .btn-edit, .btn-delete {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            text-decoration: none;
            border: none;
            transition: 0.3s;
            margin-left: 8px;
            font-size: 0.9rem;
        }

        .btn-edit { background: #f3f0ec; color: var(--deep-brown); }
        .btn-delete { background: #ffebeb; color: #d9534f; }

        .btn-edit:hover { background: var(--deep-brown); color: white; }
        .btn-delete:hover { background: #d9534f; color: white; }
    </style>
    
    <title>Barber Shop - Lista de Usuários</title>
</head>
<body>

    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <div class="hero-banner">
        <div class="container">
            <p class="text-uppercase fw-bold mb-2" style="letter-spacing: 3px; font-size: 0.8rem; color: var(--accent-brown);">Administrativo</p>
            <h1>Nossos Clientes</h1>
            <p class="font-inter opacity-75">Gerencie os acessos e perfis da sua barbearia</p>
        </div>
    </div>

    <div class="container content-wrapper">
        <div class="list-card">
            <div class="card-header-custom d-flex justify-content-between align-items-center">
                <h2>Membros Ativos</h2>
                <button class="btn btn-brown-sm">+ NOVO USUÁRIO</button>
            </div>
            
            <div class="table-responsive">
                <table class="table custom-table mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>E-mail</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(usuario of usuarios) {%>
                            <tr>
                                <td class="user-id">#<%= usuario.id %></td>
                                <td class="fw-semibold text-dark"><%= usuario.nome %></td>
                                <td><%= usuario.email %></td>
                                <td><span class="badge rounded-pill" style="background-color: #f1ede7; color: var(--deep-brown); padding: 6px 12px;">Ativo</span></td>
                                <td class="text-end">
                                    <a href="/user/edit/<%= usuario.id %>" class="btn-edit" title="Editar">✎</a>
                                    <button onclick="apagarUsuario('<%= usuario.id %>')" class="btn-delete" title="Apagar">✕</button>
                                </td>
                            </tr>
                        <% } %> 
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </body>
    
    <script>
        async function apagarUsuario(id)
        {
           const url = "/user/delete/"+id
    
           const response = await fetch(url, {method:'DELETE'})
    
            const data = await response.json()
    
            if(!response.ok)
            {
                console.log("Ocorreu um erro na requisção")
            }
    
            console.log(data)
            location.reload()
        }
    </script>
    </html>