<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <title>Barber Shop - Cadastro</title>
    <style>
        :root {
            --bg-page: #f9f5f0;
            --sidebar-brown: #3d1f14;
            --text-creme: #e6d5c3;
            --input-beige: #efe1d1;
            --btn-dark: #220f08;
            --accent-gold: #d4a373;
            --nav-width: 100px;
            --success-green: #2d5a27;
            --error-red: #8b0000;
        }

        body {
            background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), 
                        url('https://images.unsplash.com/photo-1503951914875-452162b0f3f1?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Inter', sans-serif;
            display: flex;
            min-height: 100vh;
            margin: 0;
            backdrop-filter: blur(8px);
        }

        .side-navigation {
            width: var(--nav-width);
            background: rgba(18, 10, 7, 0.95);
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 0;
            border-right: 1px solid rgba(212, 163, 115, 0.1);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 1000;
        }

        .nav-links {
            display: flex;
            flex-direction: column;
            gap: 25px;
            list-style: none;
            padding: 0;
            margin: 0;
            width: 100%;
        }

        .nav-item-link {
            color: rgba(230, 213, 195, 0.5);
            font-size: 1.4rem;
            transition: 0.3s;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 0;
        }

        .nav-item-link:hover, .nav-item-link.active {
            color: var(--accent-gold);
            background: rgba(212, 163, 115, 0.05);
        }

        .nav-label {
            font-size: 0.55rem;
            text-transform: uppercase;
            margin-top: 5px;
            letter-spacing: 1px;
            font-weight: 600;
            text-align: center;
        }

        .main-content {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: var(--nav-width);
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 850px;
            height: 600px;
            background: rgba(253, 246, 236, 0.95);
            display: flex;
            border-radius: 50px;
            overflow: hidden;
            box-shadow: 0 25px 50px rgba(0,0,0,0.3);
        }

        .sidebar-decoration {
            flex: 1;
            background: var(--sidebar-brown);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-creme);
            padding: 40px;
            text-align: center;
            border-radius: 0 160px 160px 0;
        }

        .barber-icon {
            width: 100px;
            filter: invert(86%) sepia(13%) saturate(542%) hue-rotate(349deg) brightness(95%) contrast(89%);
            margin-bottom: 20px;
        }

        .sidebar-decoration h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            line-height: 1.1;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sidebar-decoration p {
            font-size: 0.9rem;
            margin: 15px 0 0;
            opacity: 0.8;
        }

        .form-section {
            flex: 1;
            padding: 40px 60px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .form-section h2 {
            font-family: 'Playfair Display', serif;
            color: var(--sidebar-brown);
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .form-section p {
            color: #555;
            margin-bottom: 25px;
            text-align: center;
            font-size: 0.9rem;
        }

        .custom-input {
            background-color: var(--input-beige) !important;
            border: none !important;
            border-radius: 50px !important;
            padding: 12px 25px !important;
            margin-bottom: 12px;
            color: var(--sidebar-brown) !important;
        }

        .btn-register {
            background-color: var(--btn-dark) !important;
            color: white !important;
            border-radius: 50px !important;
            padding: 12px !important;
            font-weight: 700;
            width: 100%;
            margin-top: 15px;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        #feedbackMessage {
            margin-top: 15px;
            font-size: 0.85rem;
            font-weight: 600;
            display: none; 
            padding: 10px;
            border-radius: 10px;
        }

        .msg-success { color: var(--success-green); }
        .msg-error { color: var(--error-red); }
    </style>
</head>
<body>

    <nav class="side-navigation">
        <ul class="nav-links">
            <li><a href="/user/" class="nav-item-link"><i class="bi bi-house"></i><span class="nav-label">Home</span></a></li>
            <li><a href="/user/list" class="nav-item-link"><i class="bi bi-people"></i><span class="nav-label">Usuários</span></a></li>
            <li><a href="/user/create" class="nav-item-link active"><i class="bi bi-person-plus"></i><span class="nav-label">Novo Cadastro</span></a></li>
            <li class="my-2" style="border-top: 1px solid rgba(212,163,115,0.2); width: 60%; align-self: center;"></li>
            <li><a href="/atendimento/list" class="nav-item-link"><i class="bi bi-calendar-check"></i><span class="nav-label">Atendimentos</span></a></li>
            <li><a href="/atendimento/create" class="nav-item-link"><i class="bi bi-calendar-plus"></i><span class="nav-label">Agendar</span></a></li>
        </ul>
    </nav>

    <main class="main-content">
        <div class="login-card">
            <div class="sidebar-decoration">
                <img src="https://cdn-icons-png.flaticon.com/512/81/81139.png" class="barber-icon" alt="ícone tesoura">
                <h1>BARBERSHOP</h1>
                <p>Mais que um corte, uma experiência que você merece.</p>
            </div>

            <div class="form-section">
                <form id="formCadastro" class="w-100" style="max-width: 320px; text-align: center;">
                    <h2>Cadastro</h2>
                    <p>Crie sua conta para gerenciar seu perfil</p>

                    <input type="text" id="username" class="form-control custom-input" placeholder="Username" required>
                    <input type="email" id="email" class="form-control custom-input" placeholder="Email" required>
                    <input type="password" id="senha" class="form-control custom-input" placeholder="Senha" required>

                    <button id="btnCadastrarUsuario" type="submit" class="btn btn-register">CADASTRAR</button>
                    
                    <div id="feedbackMessage"></div>
                </form>
            </div>
        </div>
    </main>

<script>
    const btnCadastrarUsuario = document.getElementById("btnCadastrarUsuario")
    const feedback = document.getElementById("feedbackMessage")

    btnCadastrarUsuario.addEventListener("click", cadastrarUsuario)

    async function cadastrarUsuario(e) {
        e.preventDefault()

        const username = document.getElementById("username")
        const email = document.getElementById("email")
        const senha = document.getElementById("senha")
        const url = "/user/create"

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    username: username.value,
                    email: email.value,
                    senha: senha.value
                })
            })

            if (response.ok) {
                feedback.innerText = "✓ Cadastro realizado com sucesso!"
                feedback.className = "msg-success"
                feedback.style.display = "block"
                document.getElementById("formCadastro").reset();
                setTimeout(() => { feedback.style.display = "none" }, 4000);
            } else {
                feedback.innerText = "✕ Erro ao realizar cadastro."
                feedback.className = "msg-error"
                feedback.style.display = "block"
            }
        } catch (error) {
            feedback.innerText = "✕ Erro de conexão com o servidor."
            feedback.className = "msg-error"
            feedback.style.display = "block"
        }
    }
</script>
</body>
</html>