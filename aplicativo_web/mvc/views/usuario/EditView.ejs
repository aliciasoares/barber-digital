<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>

<body>
    <form>
        <h1> Edição do usuario</h1>

        <input type="hidden" name="usuarioid" id="usuarioid" value="<%= usuario.id %>">
       
            <div>
                <input value=" <% username %> ">Username</label>
            </div>
            <div>
                <input type="text" id="username">
            </div>

            <div>
                <input type="hidden" id="usuarioid" value="<%= usuario.id %>">


                <label for="email">E-mail</label>
            </div>
            <div>
                <input type="text" id="email">
            </div>

            <div>
                <label for="senha">Senha</label>
            </div>
            <div>
                <input type="password" id="senha">
            </div>
            <div>
                <button id="btnCadastrarUsuario" type="submit">Cadastrar</button>
            </div>


        </div>
    </form>
</body>
<script>

    const btnCadastrarUsuario = document.getElementById("btnCadastrarUsuario")

    btnCadastrarUsuario.addEventListener("click", cadastrarUsuario)

    async function cadastrarUsuario(e) {
        e.preventDefault()

        const id = document.getElementById("usuarioid")
        const username = document.getElementById("username")
        const email = document.getElementById("email")
        const senha = document.getElementById("senha")

        const url = "/user/edit"

        const response = await fetch(url, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(
                {   
                    id: id.value,
                    username: username.value,
                    email: email.value,
                    senha: senha.value
                }
            )

        })


        const data = await response.json()

        if (!response.ok) {
            console.log("Ocorreu um erro na requisição")
        }

        console.log(data)

    }
</script>

</html>